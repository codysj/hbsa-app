# Copy to .env.local and fill in. Do not commit .env.local.
# NOTE: no NEXT_PUBLIC_ prefix — these are server-only and must never reach the browser.

# Airtable personal access token with data.records:write on the base below
AIRTABLE_TOKEN=

# Base ID from the Airtable API docs URL (starts with "app")
AIRTABLE_BASE_ID=

# Optional — defaults to "Applications"
AIRTABLE_TABLE_NAME=
